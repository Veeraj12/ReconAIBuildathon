# Copy this file to .env and fill in real values. Never commit the
# real .env file — it's already excluded in .gitignore.

# Get this from your Neon project dashboard -> Connection Details.
# sslmode=require is mandatory — Neon rejects unencrypted connections.
# If this is left unset entirely, settings.py automatically falls back
# to the local db.sqlite3 file (see config/settings.py's DATABASES
# block) — useful for local development without touching Neon at all.
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
