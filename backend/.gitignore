# =========================================================
# ReconAI - Root Git Ignore
# =========================================================

# ---------------------------------------------------------
# Environment / Secrets
# ---------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.crt
secrets/
credentials/
config/secrets/

# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

*.so

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------
# Django
# ---------------------------------------------------------
*.log

db.sqlite3
db.sqlite3-journal

media/
staticfiles/

# User uploaded files
uploads/
uploaded_files/

# ---------------------------------------------------------
# Machine Learning / Model Cache
# ---------------------------------------------------------

# Hugging Face cache
.huggingface/
huggingface/
.cache/
.cache/huggingface/

# Sentence Transformers cache
sentence_transformers/

