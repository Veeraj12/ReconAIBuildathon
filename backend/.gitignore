yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

# Next.js deployment
.vercel/

# ---------------------------------------------------------
# Frontend environment
# ---------------------------------------------------------
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------------------------------------------------------
# Tauri / Rust
# ---------------------------------------------------------

# Rust build output
target/

# Tauri generated/build output
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/

# Generated installers / executables
*.exe
*.msi
*.dmg
*.app
*.deb
*.rpm
*.AppImage

# Rust temporary files
**/*.rs.bk

# ---------------------------------------------------------
# OS Files
# ---------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ---------------------------------------------------------
# IDE / Editors
# ---------------------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.iml

# ---------------------------------------------------------
# Temporary / Generated Files
# ---------------------------------------------------------

tmp/
temp/
tmp_files/
temp_files/

*.tmp
*.temp
*.bak
*.swp
*.swo

# ---------------------------------------------------------
# Reconciliation Data
# ---------------------------------------------------------

# Never commit actual financial/customer data
data/
uploads/
results/
exports/

# Excel/CSV files should generally remain local.
# If you have SAFE synthetic demo data, force-add it explicitly.
*.csv

# Uncomment this if you never want Excel files committed:
# *.xlsx
# *.xls

# ---------------------------------------------------------
# Local runtime files
# ---------------------------------------------------------

*.pid
*.pid.lock

# ---------------------------------------------------------
# Misc
# ---------------------------------------------------------

.DS_Store

# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Local SQLite fallback database (only used when DATABASE_URL isn't set)
db.sqlite3
db.sqlite3-journal

